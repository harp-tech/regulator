{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": [
          "*.md",
          "toc.yml",
          "{articles,tutorials,examples}/**/*.md",
          "{articles,tutorials,examples}/**/toc.yml"
        ],
        "exclude": "README.md"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "{articles,tutorials,examples}/**/*.{bonsai,svg}"
        ]
      }
    ],
    "output": "../artifacts/docs/site/",
    "template": [
      "default",
      "modern",
      "harp-docfx/template",
      "template"
    ],
    "sitemap": {
      "baseUrl": "https://harp-tech.org/regulator"
    },
    "globalMetadata": {
      "_appName": "Regulator",
      "_appTitle": "Harp.Regulator",
      "_appFooter": "&copy; harp-tech and Contributors. Made with <a href=\"https://dotnet.github.io/docfx\">docfx</a>",
      "_enableNewTab": true,
      "_enableSearch": true
    },
    "markdownEngineProperties": {
      "markdigExtensions": [
        "attributes",
        "customcontainers"
      ]
    }
  }
}
